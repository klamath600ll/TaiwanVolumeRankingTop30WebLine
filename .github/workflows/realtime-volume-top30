name: Taiwan Stock Realtime Volume TOP30

on:
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "github-pages"
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    outputs:
      page_url: ${{ steps.pages.outputs.page_url }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests openpyxl

      - name: Run realtime volume ranking
        run: python realtime_volume_top30.py

      - name: Configure GitHub Pages
        uses: actions/configure-pages@v5

      - name: Upload GitHub Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: site

      - name: Upload downloadable ranking files
        uses: actions/upload-artifact@v4
        with:
          name: taiwan-stock-volume-top30-files
          path: |
            taiwan_stock_volume_top30.xlsx
            listed_volume_top30.csv
            otc_volume_top30.csv
          if-no-files-found: warn
          retention-days: 7

      - name: Set Pages URL
        id: pages
        run: |
          echo "page_url=https://${GITHUB_REPOSITORY_OWNER,,}.github.io/${GITHUB_REPOSITORY#*/}/" >> "$GITHUB_OUTPUT"

  deploy:
    environment:
      name: github-pages
      url: ${{ needs.build.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build
    outputs:
      page_url: ${{ needs.build.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4

  line-notify:
    runs-on: ubuntu-latest
    needs: deploy
    steps:
      - name: Send GitHub Pages link to LINE Bot
        env:
          LINE_CHANNEL_ACCESS_TOKEN: ${{ secrets.LINE_CHANNEL_ACCESS_TOKEN }}
          LINE_USER_ID: ${{ secrets.LINE_USER_ID }}
          SITE_URL: ${{ needs.deploy.outputs.page_url }}
        run: |
          python - <<'PY'
          import json
          import os
          import urllib.request
          import urllib.error

          token = os.environ.get("LINE_CHANNEL_ACCESS_TOKEN", "").strip()
          user_id = os.environ.get("LINE_USER_ID", "").strip()
          site_url = os.environ.get("SITE_URL", "").strip()

          if not token or not user_id or not site_url:
              raise SystemExit("Missing LINE secrets or GitHub Pages URL.")

          payload = {
              "to": user_id,
              "messages": [{
                  "type": "text",
                  "text": "台股即時成交量 TOP 30 網頁已更新：\\n" + site_url
              }]
          }
          request = urllib.request.Request(
              "https://api.line.me/v2/bot/message/push",
              data=json.dumps(payload).encode("utf-8"),
              headers={
                  "Authorization": "Bearer " + token,
                  "Content-Type": "application/json"
              },
              method="POST"
          )
          try:
              with urllib.request.urlopen(request, timeout=25) as response:
                  print("LINE push succeeded:", response.status)
          except urllib.error.HTTPError as exc:
              print("LINE push failed:", exc.code, exc.read().decode("utf-8", "replace"))
              raise
          PY
